# Copy this file to .env and fill in your real values.
# Never commit .env - it contains secrets.

# ─── Database (Alembic migrations) ───────────────────────────────────
# Format: postgresql://user:password@host:5432/dbname
# For Supabase: Project Settings → Database → Connection string (URI, transaction pooler)
DATABASE_URL=

# ─── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Azure OpenAI (primary LLM source; optional - leave blank to skip it) ──
# Azure Portal → your Azure OpenAI resource → "Keys and Endpoint"
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Name of the deployment in Azure AI Foundry that points at the gpt-4.1-mini model
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Name of the deployment in Azure AI Foundry that points at a text-embedding-3-small model
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Name of the deployment in Azure AI Foundry that points at a gpt-4o-transcribe model
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe

# ─── Azure AI Speech (Cognitive Services neural TTS; optional - primary TTS
# for the "OpenAI Classic" pipeline, falls back to plain OpenAI TTS if unset
# or if a call fails) ── DIFFERENT resource from Azure OpenAI above ───
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-AndrewNeural

# ─── Deepgram ────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ─── ElevenLabs ──────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Google Calendar meeting booking (optional - leave blank to disable) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Enable the Google Calendar API on the project and add
# the redirect URI below to the client's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional - defaults to <request base URL>/api/integrations/google/callback.
# Set it explicitly when the app runs behind a proxy (e.g. the HF Space URL).
GOOGLE_OAUTH_REDIRECT_URI=
# Optional - a standard Fernet key for encrypting stored OAuth tokens.
# When blank, a key is derived from SUPABASE_JWT_SECRET instead.
INTEGRATION_TOKEN_KEY=
